# MiniMax-Hailuo-2.3（现有 Hailuo Key）
MINIMAX_API_KEY=

# MiniMax-H3（必须是支持 H3 按量计费的独立 Key）
MINIMAX_H3_API_KEY=

DEEPSEEK_API_KEY=

# 阿里云智能语音交互 NLS TTS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_APP_KEY=
# 支持：cn-shanghai / cn-beijing / cn-shenzhen
ALIYUN_TTS_REGION=cn-shanghai

# 讯飞开放平台在线语音合成 WebSocket API
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# China: https://api.minimaxi.com/v1 (default)
# International: https://api.minimax.io/v1
MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1
