# AI Planning
DEEPSEEK_API_KEY=

# Video Generation
MINIMAX_API_KEY=
MINIMAX_H3_API_KEY=
# China default; international accounts may use https://api.minimax.io/v1
MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1

# Xfyun TTS
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# Aliyun TTS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_TTS_APP_KEY=
# Supported: cn-shanghai / cn-beijing / cn-shenzhen
ALIYUN_TTS_REGION=cn-shanghai

# Optional / Reserved (visual understanding is disabled by default)
GEMINI_API_KEY=

# Web
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Leave empty to use: ~/AIProductVideoAgentProjects
WEB_PROJECTS_ROOT=

# Leave empty to use: {WEB_PROJECTS_ROOT}/.web_runtime
WEB_RUNTIME_ROOT=

WEB_TASK_WORKERS=2
WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
